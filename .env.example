# --- Required ---------------------------------------------------------------
# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL="postgresql://graveyard:graveyard@localhost:5432/graveyard?schema=public"

# Public URL of the app. Used to build the OAuth callback URL and absolute links.
APP_URL="http://localhost:3000"

# --- GitHub API (strongly recommended) --------------------------------------
# A personal access token raises the REST limit from 60 to 5,000 requests/hour.
# It only reads public data, so a fine-grained token with NO permissions is enough.
# Server-side only: never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=""

# --- GitHub OAuth (sign-in, collections, "I Want to Revive This") -----------
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: ${APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Background jobs --------------------------------------------------------
# Enables POST /api/jobs/ingest and POST /api/jobs/refresh (Authorization: Bearer <secret>).
# Leave empty to disable the endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Analysis tuning (optional) ---------------------------------------------
# Status bands in days since last commit.
# GRAVEYARD_STATUS_THRESHOLDS="recently_abandoned=180,fading=365,buried=730,ancient=1825"
# Minimum stars for /legendary
# LEGENDARY_MIN_STARS=5000
# Forks inspected in depth per analysis (3 calls each). Capped at 3 without GITHUB_TOKEN.
# ANALYSIS_FORK_DEPTH=5
# Days before a complete analysis is considered stale
# ANALYSIS_STALE_DAYS=14
# Analyses that may run at the same time in one process
# ANALYSIS_MAX_CONCURRENCY=2
# Default TTL (seconds) for cached GitHub responses
# GITHUB_CACHE_TTL_SECONDS=21600

# --- AI summaries (optional, provider-agnostic) -----------------------------
# none | openai | anthropic | gemini | local
AI_PROVIDER="none"
# AI_API_KEY=""
# AI_MODEL=""
# AI_BASE_URL=""   # e.g. http://localhost:11434/v1 for Ollama with AI_PROVIDER=local

# --- "Your AI": visitors connect their own ChatGPT plan or API key -----------
# Required to store visitors' AI credentials (encrypted). Generate with: openssl rand -base64 32
# Changing it invalidates existing connections.
ENCRYPTION_KEY=""
# Enables "Continue with ChatGPT" (OpenAI documents it for open-source / self-hosted apps).
# CHATGPT_PLAN_ENABLED=false
